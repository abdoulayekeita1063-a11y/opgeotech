<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="OPGeotech Desktop"
    Manufacturer="OPGeotech"
    Version="$(var.ProductVersion)"
    UpgradeCode="A7E0B6D1-0B4D-4C9D-9D4C-202611060002"
    Scope="perMachine">
    <SummaryInformation Description="OPGeotech Desktop Windows client and project synchronizer" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of OPGeotech Desktop is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="OPGeotech Desktop" Level="1">
      <ComponentGroupRef Id="ProgramFilesComponents" />
      <ComponentGroupRef Id="ProjectFoldersComponents" />
      <ComponentGroupRef Id="DesktopShortcutComponents" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="OPGeotech" />
    </StandardDirectory>

    <StandardDirectory Id="WindowsFolder">
      <Directory Id="OPGEOTECHROOT" Name="OPGeotech">
        <Directory Id="OPGEOTECHPROJECTS" Name="Projects" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="OPGEOTECHPROGRAMDATA" Name="OPGeotech" />
    </StandardDirectory>

    <ComponentGroup Id="ProgramFilesComponents" Directory="INSTALLFOLDER">
      <Component Id="ProgramFilesScripts" Guid="*">
        <File Id="InstallScript" Source="install-opgeotech.ps1" KeyPath="yes" />
        <File Id="SyncScript" Source="opgeotech-sync.ps1" />
        <File Id="LaunchScript" Source="opgeotech-launch.ps1" />
        <File Id="BuildScript" Source="build-installer.ps1" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ProjectFoldersComponents">
      <Component Id="ProjectRootFolder" Directory="OPGEOTECHROOT" Guid="A7E0B6D1-0B4D-4C9D-9D4C-202611060003">
        <CreateFolder />
        <RegistryValue Root="HKLM" Key="Software\OPGeotech" Name="InstallRoot" Type="string" Value="[OPGEOTECHROOT]" KeyPath="yes" />
      </Component>
      <Component Id="ProjectFilesFolder" Directory="OPGEOTECHPROJECTS" Guid="A7E0B6D1-0B4D-4C9D-9D4C-202611060004">
        <CreateFolder />
      </Component>
      <Component Id="ProgramDataFolder" Directory="OPGEOTECHPROGRAMDATA" Guid="A7E0B6D1-0B4D-4C9D-9D4C-202611060005">
        <CreateFolder />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DesktopShortcutComponents">
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
        <Shortcut
          Id="OPGeotechDesktopShortcut"
          Name="OPGeotech Desktop"
          Target="[SystemFolder]WindowsPowerShell\v1.0\powershell.exe"
          Arguments="-NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]opgeotech-launch.ps1&quot;"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\OPGeotech" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveDesktopShortcutFolder" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
